# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "OCaml bindings for the HiGHS linear and mixed-integer optimization solver"
description: """
Idiomatic OCaml interface to HiGHS (https://highs.dev), an open-source solver for linear programming, mixed-integer programming, and quadratic programming from the University of Edinburgh.

The binding is a thin, direct wrapper over the HiGHS C API. There is no intermediate C++ shim, so the stack is one FFI boundary instead of two: OCaml -> C stubs -> libhighs.

Features in 0.1.0:
- Bulk LP/MIP model passing plus incremental add_col/add_row.
- Typed enums for objective sense, integrality, and model status.
- Typed error module mirroring HighsStatus.
- Typed common options (time limit, presolve, solver, parallel, mip_rel_gap, output flag) plus escape hatches for arbitrary options by name.
- Solution readback: primal and dual values for columns and rows, objective value, model status.
- File I/O: read .mps and .lp models, write models and solutions.
- GC-managed handle lifetime via OCaml custom blocks and finalizers.

Deferred to future releases: quadratic programming, callbacks, cutpools, presolve/postsolve pipelines, basis I/O.

Requires HiGHS 1.11 or later, discoverable via pkg-config."""
maintainer: ["Aalok Thakkar"]
authors: ["Aalok Thakkar"]
license: "MIT"
tags: [
  "optimization"
  "solver"
  "linear-programming"
  "mixed-integer-programming"
  "operations-research"
  "milp"
  "lp"
  "highs"
]
homepage: "https://github.com/aalok-thakkar/ocaml-highs"
doc: "https://aalok-thakkar.github.io/ocaml-highs"
bug-reports: "https://github.com/aalok-thakkar/ocaml-highs/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.0" & >= "3.0"}
  "dune-configurator"
  "alcotest" {>= "1.5" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/aalok-thakkar/ocaml-highs.git"
# Additional metadata merged into highs.opam on top of what dune-project
# generates. Depexts tell opam how to install the HiGHS C library through
# the host package manager.

depexts: [
  ["highs"] {os-family = "homebrew"}
  ["highs"] {os-family = "arch"}
  ["libhighs-dev"] {os-family = "debian"}
  ["highs"] {os-distribution = "nixos"}
]
